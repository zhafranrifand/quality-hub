PORT=3000
DATA_DIR=./data
OWNER_EMAIL=owner@example.com
# Generate using npm run password -- "your-long-password"
OWNER_PASSWORD_HASH=
PUBLIC_ORIGIN=http://localhost:3000
# Set NODE_ENV=production on Railway; mount a volume at /data.
VOLUME_CAPACITY_BYTES=500000000
# Optional one-command Playwright -> Quality Hub integration.
# Create a plan-bound Edit token in Settings. It syncs drafts, creates runs,
# and submits reports/evidence. A Read-only token is available for API queries.
# Never commit either token.
QA_DASHBOARD_URL=http://127.0.0.1:3210
QA_PLAN_ID=
QA_BUILD_ID=
# Optional: browserName for the matching frozen plan target (defaults to chromium).
QA_BROWSER=chromium
QA_EDIT_TOKEN=
# Legacy separate tokens remain supported during migration, if needed.
# QA_SYNC_TOKEN=
# QA_RUNNER_TOKEN=
# Public repository source for Settings → Sync from GitHub (no token required).
GITHUB_REPOSITORY=owner/repository
GITHUB_BRANCH=main
GITHUB_FEATURE_ROOT=tests/targets/lokasi
GITHUB_SYNC_BROWSER=chromium
# Optional only when the source repository is private.
GITHUB_READ_TOKEN=
# Optional: resume a previously created, still-unimported automated run.
QA_RUN_ID=
